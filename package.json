{
  "name": "dots-sign",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/check-assets.mjs",
    "dev": "node --env-file-if-exists=.env server/index.ts --dev",
    "prebuild": "node scripts/check-assets.mjs",
    "build": "tsc -b && node scripts/run-framework.mjs build",
    "build:local": "node scripts/check-assets.mjs && vite build --config vite.local.config.ts --outDir dist-local",
    "dev:sites": "node --import ./scripts/sites-env.mjs scripts/run-framework.mjs dev",
    "preview": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "db:generate": "drizzle-kit generate",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "setup:key": "node scripts/setup-key.mjs",
    "verify:api": "node --env-file-if-exists=.env scripts/verify-api.ts",
    "test": "vitest run",
    "models:setup": "node scripts/setup-vision.mjs",
    "postinstall": "node scripts/setup-vision.mjs",
    "check": "npm run test && npm run build",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/noto-sans-jp": "5.3.1",
    "@mediapipe/tasks-vision": "0.10.32",
    "lucide-react": "^0.468.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "next": "16.3.4",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260702.1",
    "drizzle-kit": "0.31.10",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "1.0.0-beta.5",
    "wrangler": "4.92.0",
    "prettier": "3.9.10",
    "typescript": "~5.9.3",
    "vite": "8.0.13",
    "vitest": "5.0.5"
  }
}
